{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://spyder-bone.org/schemas/engine_check.longwave.schema.json",
 "title": "SPYDER Bone engine-check parameter file: longwave",
 "type": "object",
 "required": [
  "format",
  "format_version",
  "check",
  "id",
  "version",
  "engine_min",
  "status",
  "title",
  "licence",
  "provenance",
  "parameters",
  "golden"
 ],
 "properties": {
  "format": {
   "const": "spyder-bone/engine_check"
  },
  "format_version": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9_.]+$"
  },
  "version": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  },
  "engine_min": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+$"
  },
  "status": {
   "enum": [
    "active",
    "experimental",
    "demo",
    "withdrawn"
   ]
  },
  "title": {
   "type": "string"
  },
  "description": {
   "type": "string"
  },
  "licence": {
   "type": "string"
  },
  "created": {
   "type": "string"
  },
  "provenance": {
   "type": "object"
  },
  "check": {
   "const": "longwave"
  },
  "parameters": {
   "type": "object",
   "required": [
    "applies_to",
    "n2_window_nm",
    "tail_statistic",
    "b9_sd_above",
    "c1_sd_above",
    "when_unreliable"
   ],
   "properties": {
    "n2_window_nm": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "when_unreliable": {
     "type": "object",
     "required": [
      "b9",
      "c1"
     ],
     "properties": {
      "b9": {
       "enum": [
        "truncated",
        "not_assessed"
       ]
      },
      "c1": {
       "enum": [
        "truncated",
        "not_assessed"
       ]
      }
     },
     "additionalProperties": false
    },
    "applies_to": {
     "const": "non_native",
     "description": "every stream that is not the native standard-resolution scan (read as measured, or through a near-uncorrected correction: check.acquisition std_like_within)"
    },
    "tail_statistic": {
     "type": "object",
     "required": [
      "kernel",
      "windows"
     ],
     "description": "a linear statistic: sum over windows of weight x mean E over [lo, hi] nm (inclusive), E = scale x Savitzky-Golay derivative of absorbance (the kernel)",
     "properties": {
      "kernel": {
       "oneOf": [
        {
         "type": "string"
        },
        {
         "type": "object",
         "required": [
          "absorbance_clip",
          "savgol",
          "scale"
         ],
         "properties": {
          "absorbance_clip": {
           "type": "number",
           "exclusiveMinimum": 0
          },
          "savgol": {
           "type": "object"
          },
          "scale": {
           "type": "number"
          }
         }
        }
       ]
      },
      "windows": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
       }
      },
      "of": {
       "type": "string"
      }
     }
    },
    "correlation_nm": {
     "type": "number",
     "minimum": 0
    },
    "b9_sd_above": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "c1_sd_above": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "anchor": {
     "type": "object"
    }
   }
  },
  "golden": {
   "type": "object",
   "required": [
    "cases"
   ],
   "properties": {
    "spectra_file": {
     "type": "string"
    },
    "tolerance": {
     "type": "object",
     "required": [
      "abs",
      "rel"
     ],
     "properties": {
      "abs": {
       "type": "number",
       "maximum": 1e-09
      },
      "rel": {
       "type": "number",
       "maximum": 1e-09
      }
     }
    },
    "cases": {
     "type": "array",
     "minItems": 3,
     "items": {
      "type": "object",
      "required": [
       "name",
       "expected"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "expected": {
        "type": "object",
        "minProperties": 1
       }
      }
     }
    }
   }
  }
 }
}
