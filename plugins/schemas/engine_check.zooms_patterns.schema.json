{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://spyder-bone.org/schemas/engine_check.zooms_patterns.schema.json",
 "title": "SPYDER Bone engine-check parameter file: zooms_patterns",
 "type": "object",
 "required": [
  "format",
  "format_version",
  "check",
  "id",
  "version",
  "engine_min",
  "status",
  "title",
  "licence",
  "provenance",
  "parameters",
  "golden"
 ],
 "properties": {
  "format": {
   "const": "spyder-bone/engine_check"
  },
  "format_version": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9_.]+$"
  },
  "version": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  },
  "engine_min": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+$"
  },
  "status": {
   "enum": [
    "active",
    "experimental",
    "demo",
    "withdrawn"
   ]
  },
  "title": {
   "type": "string"
  },
  "description": {
   "type": "string"
  },
  "licence": {
   "type": "string"
  },
  "created": {
   "type": "string"
  },
  "provenance": {
   "type": "object"
  },
  "check": {
   "const": "zooms_patterns"
  },
  "parameters": {
   "type": "object",
   "required": [
    "kernel",
    "protein_bands",
    "ch_bands",
    "lit_if_E_above",
    "readability"
   ],
   "properties": {
    "kernel": {
     "type": "object",
     "required": [
      "absorbance_clip",
      "savgol",
      "scale"
     ],
     "properties": {
      "absorbance_clip": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "savgol": {
       "type": "object",
       "required": [
        "window",
        "polyorder",
        "deriv",
        "delta",
        "mode"
       ],
       "properties": {
        "window": {
         "type": "integer"
        },
        "polyorder": {
         "type": "integer"
        },
        "deriv": {
         "type": "integer"
        },
        "delta": {
         "type": "number"
        },
        "mode": {
         "enum": [
          "interp",
          "mirror",
          "nearest",
          "constant",
          "wrap",
          "zero_edges",
          "valid"
         ],
         "description": "stated per PLAN section 7; the engine checks read interior points only, so the edge mode never enters a reading"
        }
       }
      },
      "scale": {
       "type": "number"
      }
     }
    },
    "protein_bands": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z]{2}[0-9]{4}[a-z]?$"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "ch_bands": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z]{2}[0-9]{4}[a-z]?$"
     },
     "minItems": 1
    },
    "readability": {
     "type": "object",
     "required": [
      "sd_max_frac_w",
      "unreadable_only_if_E_below_frac_w"
     ]
    },
    "vote": {
     "type": "object",
     "required": [
      "band",
      "lit_if_u_above",
      "from_verdict",
      "to_verdict"
     ],
     "properties": {
      "band": {
       "type": "string",
       "pattern": "^[A-Z]{2}[0-9]{4}[a-z]?$"
      },
      "lit_if_u_above": {
       "type": "number"
      },
      "from_verdict": {
       "enum": [
        "Unlikely",
        "Borderline",
        "Good",
        "Can't tell"
       ]
      },
      "to_verdict": {
       "enum": [
        "Unlikely",
        "Borderline",
        "Good",
        "Can't tell"
       ]
      }
     }
    }
   }
  },
  "golden": {
   "type": "object",
   "required": [
    "cases"
   ],
   "properties": {
    "spectra_file": {
     "type": "string"
    },
    "tolerance": {
     "type": "object",
     "required": [
      "abs",
      "rel"
     ],
     "properties": {
      "abs": {
       "type": "number",
       "maximum": 1e-09
      },
      "rel": {
       "type": "number",
       "maximum": 1e-09
      }
     }
    },
    "cases": {
     "type": "array",
     "minItems": 3,
     "items": {
      "type": "object",
      "required": [
       "name",
       "expected"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "expected": {
        "type": "object",
        "minProperties": 1
       }
      }
     }
    }
   }
  }
 }
}
