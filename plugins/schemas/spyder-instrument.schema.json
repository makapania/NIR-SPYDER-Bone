{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://spyder-bone.org/schemas/spyder-instrument.schema.json",
 "title": "SPYDER Bone instrument registry (classes, serial presets, other instruments' file formats)",
 "type": "object",
 "required": [
  "format",
  "format_version",
  "id",
  "version",
  "engine_min",
  "status",
  "default_class",
  "classes"
 ],
 "properties": {
  "format_version": {
   "const": 1
  },
  "id": {
   "type": "string"
  },
  "version": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  },
  "engine_min": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+$"
  },
  "status": {
   "enum": [
    "active",
    "experimental",
    "demo",
    "withdrawn"
   ]
  },
  "licence": {
   "type": "string"
  },
  "created": {
   "type": "string"
  },
  "title": {
   "type": "string"
  },
  "description": {
   "type": "string"
  },
  "provenance": {
   "type": "object"
  },
  "format": {
   "const": "spyder-bone/instrument"
  },
  "default_class": {
   "type": "string"
  },
  "switch": {
   "type": "object"
  },
  "accepted_input": {
   "type": "object"
  },
  "classes": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
    "type": "object",
    "required": [
     "display_name",
     "serials"
    ],
    "properties": {
     "display_name": {
      "type": "string"
     },
     "long_name": {
      "type": "string"
     },
     "nominal_fwhm_nm": {
      "type": "object"
     },
     "header_hint": {
      "type": "object",
      "properties": {
       "swir_gain": {
        "type": "array",
        "items": {
         "type": "integer",
         "minimum": 0
        },
        "minItems": 2,
        "maxItems": 2
       },
       "file_format": {
        "type": "array",
        "items": {
         "enum": [
          "as8",
          "as7",
          "legacy"
         ]
        },
        "description": "a file of this format is scored as this class (unless unless_joins_nm excludes it)"
       },
       "unless_joins_nm": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 1,
        "description": "with file_format: a file of that format whose detector joins, as found in the file (the header, else the white-reference DN; never the default 1000/1800 used when neither gives them), are exactly these is not this class's file; it is read as a LabSpec 4 file and the switch decides its class"
       }
      },
      "dependentRequired": {
       "unless_joins_nm": [
        "file_format"
       ]
      }
     },
     "serials": {
      "type": "array",
      "items": {
       "type": "integer",
       "minimum": 0
      },
      "uniqueItems": true
     }
    }
   }
  }
 }
}
