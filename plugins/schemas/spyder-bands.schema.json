{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://spyder-bone.org/schemas/spyder-bands.schema.json",
 "title": "SPYDER Bone shared band table (bands.json, format 2: readability gains computed for each correction)",
 "type": "object",
 "required": [
  "format",
  "format_version",
  "id",
  "version",
  "engine_min",
  "status",
  "kernels",
  "noise_model",
  "bands",
  "golden"
 ],
 "properties": {
  "format_version": {
   "const": 2
  },
  "id": {
   "type": "string"
  },
  "version": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  },
  "engine_min": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+$"
  },
  "status": {
   "enum": [
    "active",
    "experimental",
    "demo",
    "withdrawn"
   ]
  },
  "licence": {
   "type": "string"
  },
  "created": {
   "type": "string"
  },
  "title": {
   "type": "string"
  },
  "description": {
   "type": "string"
  },
  "provenance": {
   "type": "object"
  },
  "format": {
   "const": "spyder-bone/bands"
  },
  "n2": {
   "type": "object"
  },
  "golden": {
   "type": "object",
   "required": [
    "spectra_file",
    "cases"
   ],
   "properties": {
    "spectra_file": {
     "type": "string"
    },
    "tolerance": {
     "type": "object"
    },
    "corrections": {
     "type": "object",
     "description": "named corrections the cases use: an operator list (as a transfer file's) and optional instrument_noise",
     "propertyNames": {
      "not": {
       "const": "none"
      }
     },
     "additionalProperties": {
      "type": "object",
      "required": [
       "operator"
      ],
      "properties": {
       "operator": {
        "type": "array",
        "minItems": 1
       },
       "instrument_noise": {
        "type": "object",
        "description": "an instrument's own noise, measured on its scans; overrides the noise tables' defaults for outputs read through this correction",
        "properties": {
         "correlation_nm": {
          "type": "number",
          "minimum": 0
         },
         "ch_envelope_factors": {
          "type": "object",
          "additionalProperties": {
           "type": "number",
           "exclusiveMinimum": 0
          }
         }
        }
       }
      }
     }
    },
    "cases": {
     "type": "array",
     "minItems": 3,
     "items": {
      "type": "object",
      "required": [
       "spectrum_sha256",
       "correction",
       "expected"
      ],
      "properties": {
       "spectrum_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       },
       "correction": {
        "type": "string",
        "description": "'none' or a name in the golden block's corrections"
       },
       "splices_nm": {
        "type": "array",
        "items": {
         "type": "number"
        }
       },
       "expected": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
         "type": "number"
        }
       }
      }
     }
    }
   }
  },
  "projections": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "window_nm",
     "kernel",
     "direction",
     "centre"
    ],
    "properties": {
     "window_nm": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
       "type": "number"
      }
     },
     "kernel": {
      "type": "string"
     },
     "direction": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "number"
      }
     },
     "centre": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "number"
      }
     },
     "source": {
      "type": "object"
     }
    }
   }
  },
  "kernels": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "absorbance_clip_min",
     "savgol",
     "scale"
    ],
    "properties": {
     "absorbance_clip_min": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "savgol": {
      "type": "object",
      "required": [
       "window",
       "polyorder",
       "deriv"
      ]
     },
     "scale": {
      "type": "number"
     }
    }
   }
  },
  "bands": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
    "type": "object",
    "required": [
     "centre_nm",
     "half_width_nm",
     "kernel",
     "detector",
     "roles"
    ],
    "properties": {
     "centre_nm": {
      "type": "number"
     },
     "half_width_nm": {
      "type": "integer",
      "minimum": 0
     },
     "kernel": {
      "type": "string"
     },
     "detector": {
      "enum": [
       "VNIR",
       "SWIR1",
       "SWIR2"
      ]
     },
     "roles": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "weight": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "faint_u": {
      "type": "number"
     },
     "projection": {
      "type": "string"
     },
     "u_sign": {
      "enum": [
       -1,
       1
      ]
     },
     "noise_window_nm": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
       "type": "number"
      }
     },
     "readability": {
      "type": "object",
      "required": [
       "noise_window_nm"
      ],
      "properties": {
       "noise_window_nm": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
         "type": "number"
        }
       },
       "envelope_factor": {
        "type": "number",
        "exclusiveMinimum": 0,
        "description": "the within-detector noise envelope at the band (default 1)"
       },
       "envelope_provenance": {
        "type": "string"
       },
       "provisional": {
        "type": "boolean"
       },
       "note": {
        "type": "string"
       },
       "window_choice": {
        "type": "string"
       },
       "gain_source": {
        "type": "string"
       }
      },
      "not": {
       "required": [
        "gain_E_per_N2"
       ],
       "description": "per-transfer gains are format 1"
      }
     }
    }
   }
  },
  "noise_model": {
   "type": "object",
   "required": [
    "correlation_nm"
   ],
   "description": "the noise model of the computed gains: white noise in absorbance smoothed by a Gaussian of correlation_nm (sigma, nm), independent between detector segments",
   "properties": {
    "correlation_nm": {
     "type": "number",
     "minimum": 0
    },
    "description": {
     "type": "string"
    }
   }
  }
 }
}
