{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://spyder-bone.org/schemas/engine_check.signs.schema.json",
 "title": "SPYDER Bone engine-check parameter file: signs",
 "type": "object",
 "required": [
  "format",
  "format_version",
  "check",
  "id",
  "version",
  "engine_min",
  "status",
  "title",
  "licence",
  "provenance",
  "parameters",
  "golden"
 ],
 "properties": {
  "format": {
   "const": "spyder-bone/engine_check"
  },
  "format_version": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9_.]+$"
  },
  "version": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  },
  "engine_min": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+$"
  },
  "status": {
   "enum": [
    "active",
    "experimental",
    "demo",
    "withdrawn"
   ]
  },
  "title": {
   "type": "string"
  },
  "description": {
   "type": "string"
  },
  "licence": {
   "type": "string"
  },
  "created": {
   "type": "string"
  },
  "provenance": {
   "type": "object"
  },
  "check": {
   "const": "signs"
  },
  "parameters": {
   "type": "object",
   "required": [
    "kernel",
    "plaster",
    "wax",
    "ester",
    "burnt",
    "gate"
   ],
   "properties": {
    "kernel": {
     "type": "object",
     "required": [
      "absorbance_clip",
      "savgol",
      "scale"
     ],
     "properties": {
      "absorbance_clip": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "savgol": {
       "type": "object",
       "required": [
        "window",
        "polyorder",
        "deriv",
        "delta",
        "mode"
       ],
       "properties": {
        "window": {
         "type": "integer"
        },
        "polyorder": {
         "type": "integer"
        },
        "deriv": {
         "type": "integer"
        },
        "delta": {
         "type": "number"
        },
        "mode": {
         "enum": [
          "interp",
          "mirror",
          "nearest",
          "constant",
          "wrap",
          "zero_edges",
          "valid"
         ],
         "description": "stated per PLAN section 7; the engine checks read interior points only, so the edge mode never enters a reading"
        }
       }
      },
      "scale": {
       "type": "number"
      }
     }
    },
    "plaster": {
     "type": "object",
     "required": [
      "bands",
      "fires_if_joint_load_above"
     ],
     "properties": {
      "bands": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "object",
        "required": [
         "sharp",
         "fauna_median",
         "plaster_contrast"
        ],
        "properties": {
         "sharp": {
          "type": "array",
          "items": {
           "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
         }
        }
       }
      }
     }
    },
    "wax": {
     "type": "object",
     "required": [
      "all_of"
     ],
     "properties": {
      "all_of": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "sharp",
         "at_least"
        ],
        "properties": {
         "sharp": {
          "type": "array",
          "items": {
           "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
         }
        }
       }
      }
     }
    },
    "ester": {
     "type": "object",
     "required": [
      "sharp",
      "at_least"
     ],
     "properties": {
      "sharp": {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 4,
       "maxItems": 4
      }
     }
    },
    "soft_tier": {
     "type": "object",
     "required": [
      "ester",
      "plaster",
      "requires_no_hard_sign",
      "eligibility"
     ],
     "properties": {
      "ester": {
       "type": "object",
       "required": [
        "at_least"
       ],
       "properties": {
        "at_least": {
         "type": "number"
        }
       }
      },
      "plaster": {
       "type": "object",
       "required": [
        "joint_load_at_least"
       ],
       "properties": {
        "joint_load_at_least": {
         "type": "number"
        }
       }
      },
      "requires_no_hard_sign": {
       "type": "array",
       "items": {
        "enum": [
         "plaster",
         "wax",
         "ester",
         "burnt",
         "C1"
        ]
       }
      },
      "eligibility": {
       "type": "object",
       "required": [
        "always_classes",
        "otherwise_n2_window_nm",
        "otherwise_n2_at_most"
       ],
       "properties": {
        "always_classes": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "otherwise_n2_window_nm": {
         "type": "array",
         "items": {
          "type": "number"
         },
         "minItems": 2,
         "maxItems": 2
        },
        "otherwise_n2_at_most": {
         "type": "number"
        }
       }
      }
     }
    }
   },
   "not": {
    "required": [
     "clay"
    ]
   }
  },
  "golden": {
   "type": "object",
   "required": [
    "cases"
   ],
   "properties": {
    "spectra_file": {
     "type": "string"
    },
    "tolerance": {
     "type": "object",
     "required": [
      "abs",
      "rel"
     ],
     "properties": {
      "abs": {
       "type": "number",
       "maximum": 1e-09
      },
      "rel": {
       "type": "number",
       "maximum": 1e-09
      }
     }
    },
    "cases": {
     "type": "array",
     "minItems": 3,
     "items": {
      "type": "object",
      "required": [
       "name",
       "expected"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "expected": {
        "type": "object",
        "minProperties": 1
       }
      }
     }
    }
   }
  }
 }
}
