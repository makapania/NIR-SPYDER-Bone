{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://spyder-bone.org/schemas/spyder-noise-gains.schema.json",
 "title": "SPYDER Bone noise propagation (noise_gains.json, format 2: gains computed for each correction)",
 "type": "object",
 "required": [
  "format",
  "format_version",
  "id",
  "version",
  "engine_min",
  "status",
  "provisional",
  "noise_model",
  "model_noise_windows_nm",
  "golden"
 ],
 "properties": {
  "format_version": {
   "const": 2
  },
  "id": {
   "type": "string"
  },
  "version": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  },
  "engine_min": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+$"
  },
  "status": {
   "enum": [
    "active",
    "experimental",
    "demo",
    "withdrawn"
   ]
  },
  "licence": {
   "type": "string"
  },
  "created": {
   "type": "string"
  },
  "title": {
   "type": "string"
  },
  "description": {
   "type": "string"
  },
  "provenance": {
   "type": "object"
  },
  "format": {
   "const": "spyder-bone/noise_gains"
  },
  "provisional": {
   "type": "boolean"
  },
  "n2": {
   "type": "object"
  },
  "golden": {
   "type": "object",
   "required": [
    "spectra_file",
    "cases"
   ],
   "properties": {
    "spectra_file": {
     "type": "string"
    },
    "tolerance": {
     "type": "object"
    },
    "corrections": {
     "type": "object",
     "description": "named corrections the cases use: an operator list (as a transfer file's) and optional instrument_noise",
     "propertyNames": {
      "not": {
       "const": "none"
      }
     },
     "additionalProperties": {
      "type": "object",
      "required": [
       "operator"
      ],
      "properties": {
       "operator": {
        "type": "array",
        "minItems": 1
       },
       "instrument_noise": {
        "type": "object",
        "description": "an instrument's own noise, measured on its scans; overrides the noise tables' defaults for outputs read through this correction",
        "properties": {
         "correlation_nm": {
          "type": "number",
          "minimum": 0
         },
         "ch_envelope_factors": {
          "type": "object",
          "additionalProperties": {
           "type": "number",
           "exclusiveMinimum": 0
          }
         }
        }
       }
      }
     }
    },
    "cases": {
     "type": "array",
     "minItems": 3,
     "items": {
      "type": "object",
      "required": [
       "spectrum_sha256",
       "correction",
       "expected"
      ],
      "properties": {
       "spectrum_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       },
       "correction": {
        "type": "string",
        "description": "'none' or a name in the golden block's corrections"
       },
       "splices_nm": {
        "type": "array",
        "items": {
         "type": "number"
        }
       },
       "expected": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
         "type": "number"
        }
       }
      }
     }
    },
    "models": {
     "type": "object",
     "description": "model id -> the file sha256 of the model the SD cases were computed for",
     "additionalProperties": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     }
    }
   }
  },
  "models": {
   "type": "object",
   "description": "per-model settings; models not listed: computed gains, B6 applies",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "b6": {
      "type": "boolean"
     },
     "recorded": {
      "type": "object",
      "required": [
       "terms"
      ],
      "properties": {
       "terms": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "object",
         "required": [
          "window_nm",
          "gain"
         ],
         "properties": {
          "window_nm": {
           "type": "array",
           "minItems": 2,
           "maxItems": 2,
           "items": {
            "type": "number"
           }
          },
          "gain": {
           "type": "number",
           "exclusiveMinimum": 0
          },
          "detector": {
           "type": "string"
          }
         }
        }
       },
       "applies_to": {
        "type": "string"
       }
      }
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "consensus": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "factor"
    ],
    "properties": {
     "factor": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "components": {
      "type": "string"
     },
     "basis": {
      "type": "string"
     }
    }
   }
  },
  "noise_model": {
   "type": "object",
   "required": [
    "correlation_nm"
   ],
   "description": "the noise model of the computed gains: white noise in absorbance smoothed by a Gaussian of correlation_nm (sigma, nm), independent between detector segments",
   "properties": {
    "correlation_nm": {
     "type": "number",
     "minimum": 0
    },
    "description": {
     "type": "string"
    }
   }
  },
  "model_noise_windows_nm": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "array",
    "minItems": 2,
    "maxItems": 2,
    "items": {
     "type": "number"
    }
   },
   "description": "one N2 window per detector segment a model kernel may read"
  },
  "model_noise_windows_note": {
   "type": "string"
  }
 }
}
