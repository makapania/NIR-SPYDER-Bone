{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://spyder-bone.org/schemas/spyder-reference-set.schema.json",
 "title": "SPYDER Bone reference spectra set",
 "type": "object",
 "required": [
  "format",
  "format_version",
  "id",
  "version",
  "engine_min",
  "status",
  "grid",
  "levels"
 ],
 "properties": {
  "format_version": {
   "const": 1
  },
  "id": {
   "type": "string"
  },
  "version": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  },
  "engine_min": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+$"
  },
  "status": {
   "enum": [
    "active",
    "experimental",
    "demo",
    "withdrawn"
   ]
  },
  "licence": {
   "type": "string"
  },
  "created": {
   "type": "string"
  },
  "title": {
   "type": "string"
  },
  "description": {
   "type": "string"
  },
  "provenance": {
   "type": "object"
  },
  "format": {
   "const": "spyder-bone/reference_set"
  },
  "grid": {
   "type": "object"
  },
  "source": {
   "type": "object"
  },
  "levels": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "label",
     "n",
     "members",
     "absorbance"
    ],
    "properties": {
     "label": {
      "type": "string"
     },
     "display_label": {
      "type": "string"
     },
     "n": {
      "type": "integer",
      "minimum": 1
     },
     "members": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "absorbance": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "number"
      }
     }
    }
   }
  }
 }
}
