{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://spyder-bone.org/schemas/engine_check.evidence_levels.schema.json",
 "title": "SPYDER Bone engine-check parameter file: evidence_levels",
 "type": "object",
 "required": [
  "format",
  "format_version",
  "check",
  "id",
  "version",
  "engine_min",
  "status",
  "title",
  "licence",
  "provenance",
  "parameters",
  "golden"
 ],
 "properties": {
  "format": {
   "const": "spyder-bone/engine_check"
  },
  "format_version": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9_.]+$"
  },
  "version": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  },
  "engine_min": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+$"
  },
  "status": {
   "enum": [
    "active",
    "experimental",
    "demo",
    "withdrawn"
   ]
  },
  "title": {
   "type": "string"
  },
  "description": {
   "type": "string"
  },
  "licence": {
   "type": "string"
  },
  "created": {
   "type": "string"
  },
  "provenance": {
   "type": "object"
  },
  "check": {
   "const": "evidence_levels"
  },
  "parameters": {
   "type": "object",
   "required": [
    "kernel",
    "core_bands",
    "extra_band",
    "extra_band_faint_u",
    "readability",
    "thresholds_u",
    "guard",
    "none_rule",
    "nh_type_bands",
    "nh_type_min_u",
    "clear_min_lit_core"
   ],
   "properties": {
    "kernel": {
     "type": "object",
     "required": [
      "absorbance_clip",
      "savgol",
      "scale"
     ],
     "properties": {
      "absorbance_clip": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "savgol": {
       "type": "object",
       "required": [
        "window",
        "polyorder",
        "deriv",
        "delta",
        "mode"
       ],
       "properties": {
        "window": {
         "type": "integer"
        },
        "polyorder": {
         "type": "integer"
        },
        "deriv": {
         "type": "integer"
        },
        "delta": {
         "type": "number"
        },
        "mode": {
         "enum": [
          "interp",
          "mirror",
          "nearest",
          "constant",
          "wrap",
          "zero_edges",
          "valid"
         ],
         "description": "stated per PLAN section 7; the engine checks read interior points only, so the edge mode never enters a reading"
        }
       }
      },
      "scale": {
       "type": "number"
      }
     }
    },
    "core_bands": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z]{2}[0-9]{4}[a-z]?$"
     },
     "minItems": 1
    },
    "extra_band": {
     "type": "string",
     "pattern": "^[A-Z]{2}[0-9]{4}[a-z]?$"
    },
    "readability": {
     "type": "object",
     "required": [
      "sd_max_u",
      "unreadable_only_if_u_below"
     ]
    },
    "thresholds_u": {
     "type": "object",
     "required": [
      "clear",
      "strong"
     ]
    },
    "guard": {
     "type": "object",
     "required": [
      "window_nm",
      "max_E_below"
     ],
     "properties": {
      "window_nm": {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 2,
       "maxItems": 2
      }
     }
    },
    "none_rule": {
     "type": "object",
     "required": [
      "must_be_readable",
      "min_readable_core",
      "extra_band_max_u"
     ]
    }
   }
  },
  "golden": {
   "type": "object",
   "required": [
    "cases"
   ],
   "properties": {
    "spectra_file": {
     "type": "string"
    },
    "tolerance": {
     "type": "object",
     "required": [
      "abs",
      "rel"
     ],
     "properties": {
      "abs": {
       "type": "number",
       "maximum": 1e-09
      },
      "rel": {
       "type": "number",
       "maximum": 1e-09
      }
     }
    },
    "cases": {
     "type": "array",
     "minItems": 3,
     "items": {
      "type": "object",
      "required": [
       "name",
       "expected"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "expected": {
        "type": "object",
        "minProperties": 1
       }
      }
     }
    }
   }
  }
 }
}
