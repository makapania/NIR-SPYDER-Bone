{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://spyder-bone.org/schemas/engine_check.acquisition.schema.json",
 "title": "SPYDER Bone engine-check parameter file: acquisition",
 "type": "object",
 "required": [
  "format",
  "format_version",
  "check",
  "id",
  "version",
  "engine_min",
  "status",
  "title",
  "licence",
  "provenance",
  "parameters",
  "golden"
 ],
 "properties": {
  "format": {
   "const": "spyder-bone/engine_check"
  },
  "format_version": {
   "const": 1
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9_.]+$"
  },
  "version": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
  },
  "engine_min": {
   "type": "string",
   "pattern": "^[0-9]+\\.[0-9]+$"
  },
  "status": {
   "enum": [
    "active",
    "experimental",
    "demo",
    "withdrawn"
   ]
  },
  "title": {
   "type": "string"
  },
  "description": {
   "type": "string"
  },
  "licence": {
   "type": "string"
  },
  "created": {
   "type": "string"
  },
  "provenance": {
   "type": "object"
  },
  "check": {
   "const": "acquisition"
  },
  "parameters": {
   "type": "object",
   "required": [
    "input_matrix",
    "integrity_range_nm",
    "B2_saturation",
    "B3_impossible",
    "B4_panel_or_empty",
    "B5_dark",
    "B6_noise",
    "B6b_signs_gate",
    "B7_above_one",
    "B8_splice_step"
   ],
   "properties": {
    "B6_noise": {
     "type": "object",
     "required": [
      "cuts",
      "check_if_cut_within_sd"
     ],
     "properties": {
      "cuts": {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 1
      },
      "check_if_cut_within_sd": {
       "type": "number"
      }
     }
    },
    "B6b_signs_gate": {
     "type": "object",
     "required": [
      "n2_window_nm",
      "signs",
      "contaminant_signs",
      "uncorrected",
      "std_like_within",
      "corrected",
      "kernels",
      "statistics"
     ],
     "properties": {
      "n2_window_nm": {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 2,
       "maxItems": 2
      },
      "signs": {
       "type": "array",
       "items": {
        "enum": [
         "plaster",
         "wax",
         "ester",
         "burnt",
         "C1"
        ]
       },
       "minItems": 1
      },
      "contaminant_signs": {
       "type": "array",
       "items": {
        "enum": [
         "plaster",
         "wax",
         "ester",
         "burnt",
         "C1"
        ]
       },
       "minItems": 1
      },
      "uncorrected": {
       "type": "object",
       "description": "per sign: gated when N2(n2_window_nm) > n2_above (a stream read as measured, or a near-uncorrected correction); a null gate is never gated",
       "propertyNames": {
        "enum": [
         "plaster",
         "wax",
         "ester",
         "burnt",
         "C1"
        ]
       },
       "additionalProperties": {
        "oneOf": [
         {
          "type": "null"
         },
         {
          "type": "object",
          "required": [
           "n2_window_nm",
           "n2_above"
          ],
          "properties": {
           "n2_window_nm": {
            "type": "array",
            "items": {
             "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
           },
           "n2_above": {
            "type": "number"
           }
          }
         }
        ]
       }
      },
      "std_like_within": {
       "type": "number",
       "minimum": 0,
       "description": "a correction whose every noise-policy statistic (these gate and fallback statistics, check.longwave's tail reading, check.signs' soft-tier statistic) has a noise gain within this fraction of its uncorrected gain is near-uncorrected: the uncorrected table, and every noise policy treats the stream exactly like a native standard-resolution scan"
      },
      "corrected": {
       "type": "object",
       "propertyNames": {
        "enum": [
         "plaster",
         "wax",
         "ester",
         "burnt",
         "C1"
        ]
       },
       "additionalProperties": {
        "oneOf": [
         {
          "type": "null"
         },
         {
          "type": "object",
          "required": [
           "statistic",
           "n2_window_nm",
           "sd_above"
          ],
          "properties": {
           "statistic": {
            "type": "string"
           },
           "n2_window_nm": {
            "type": "array",
            "items": {
             "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
           },
           "sd_above": {
            "type": "number",
            "exclusiveMinimum": 0
           }
          }
         }
        ]
       }
      },
      "fallbacks": {
       "type": "object",
       "propertyNames": {
        "enum": [
         "plaster",
         "C1"
        ]
       },
       "additionalProperties": {
        "type": "object",
        "required": [
         "variant",
         "statistic",
         "n2_window_nm",
         "sd_at_most"
        ],
        "properties": {
         "variant": {
          "enum": [
           "band_1446",
           "swir1"
          ]
         },
         "statistic": {
          "type": "string"
         },
         "n2_window_nm": {
          "type": "array",
          "items": {
           "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
         },
         "sd_at_most": {
          "type": "number",
          "exclusiveMinimum": 0
         }
        }
       }
      },
      "correlation_nm": {
       "type": "number",
       "minimum": 0
      },
      "kernels": {
       "type": "object",
       "additionalProperties": {
        "type": "object",
        "required": [
         "absorbance_clip",
         "savgol",
         "scale"
        ],
        "properties": {
         "absorbance_clip": {
          "type": "number",
          "exclusiveMinimum": 0
         },
         "savgol": {
          "type": "object"
         },
         "scale": {
          "type": "number"
         }
        }
       }
      },
      "statistics": {
       "type": "object",
       "minProperties": 1,
       "additionalProperties": {
        "type": "object",
        "required": [
         "kernel",
         "windows"
        ],
        "description": "a linear statistic: sum over windows of weight x mean E over [lo, hi] nm (inclusive), E = scale x Savitzky-Golay derivative of absorbance (the kernel)",
        "properties": {
         "kernel": {
          "oneOf": [
           {
            "type": "string"
           },
           {
            "type": "object",
            "required": [
             "absorbance_clip",
             "savgol",
             "scale"
            ],
            "properties": {
             "absorbance_clip": {
              "type": "number",
              "exclusiveMinimum": 0
             },
             "savgol": {
              "type": "object"
             },
             "scale": {
              "type": "number"
             }
            }
           }
          ]
         },
         "windows": {
          "type": "array",
          "minItems": 1,
          "items": {
           "type": "array",
           "items": {
            "type": "number"
           },
           "minItems": 3,
           "maxItems": 3
          }
         },
         "of": {
          "type": "string"
         }
        }
       }
      },
      "anchor": {
       "type": "object"
      }
     }
    },
    "B8_splice_step": {
     "type": "object",
     "required": [
      "fits",
      "note_above",
      "check_above"
     ]
    }
   }
  },
  "golden": {
   "type": "object",
   "required": [
    "cases"
   ],
   "properties": {
    "spectra_file": {
     "type": "string"
    },
    "tolerance": {
     "type": "object",
     "required": [
      "abs",
      "rel"
     ],
     "properties": {
      "abs": {
       "type": "number",
       "maximum": 1e-09
      },
      "rel": {
       "type": "number",
       "maximum": 1e-09
      }
     }
    },
    "cases": {
     "type": "array",
     "minItems": 3,
     "items": {
      "type": "object",
      "required": [
       "name",
       "expected"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "expected": {
        "type": "object",
        "minProperties": 1
       }
      }
     }
    }
   }
  }
 }
}
