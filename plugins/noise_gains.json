 "licence": "CC-BY-4.0",
 "created": "2026-10-19",
 "title": "Noise propagation for B6: the implied SD of each model reading, computed from the model and the correction",
 "description": "Implied SD of a collagen reading (wt%) = sqrt(sum over the kernel's detector parts of (gain x N2(window))^2), N2 on the AS-MEASURED scan. The engine computes each gain (format 2) from the model's own linear kernel (its Savitzky-Golay steps and coefficients folded onto absorbance), the correction actually applied before the model (its blur and absorbance gain per detector segment, linearised; none for a scan read as measured) and the scan's own detector joins, under noise_model; each detector part uses the window of model_noise_windows_nm that lies in its segment. A consensus model's SD = factor x median of its components' SDs (each component folded from the consensus file itself). Not assessed, with the reason: a non-linear correction (block SNV), a non-linear model without a recorded gain, a kernel or noise window not inside one detector segment of the scan (not available on this instrument), a non-finite N2. 'models' holds per-model settings: b6 false = the SD is reported but B6 is not applied to that reader; recorded = the gain of a non-linear model, for the scan as measured only. Provisional: never calibrated on same-spot repeats; B6 raises a Check only. Band readability lives in bands.json.",
 "n2": {
  "definition": "canonical N2 (reference/spyder_ref/n2.py): A = log10(1/max(R, 1e-4)) on the full as-measured grid; second difference centred on each channel; centres lo <= lambda < hi; 1.4826 x MAD; units 1e-5",
  "measured_on": "the AS-MEASURED scan, never the transferred stream"
 },
 "noise_model": {
  "correlation_nm": 1.25,
  "description": "white noise in absorbance smoothed by a Gaussian of this sigma (nm), independent between detector segments (the ASD files' own residual autocorrelation); taps to +-8 sigma. A correction file may give its instrument's own value in provenance.instrument_noise.correlation_nm, measured on that instrument's scans (another instrument, or a resampled grid, has its own)."
 },
 "model_noise_windows_nm": [
  [
   1500,
   1550
  ],
  [
   2000,
   2100
  ]
 ],
 "model_noise_windows_note": "one N2 window per detector segment a model kernel may read (on the LabSpec SWIR1 1500-1550 nm and SWIR2 2000-2100 nm, the windows of format 1); the kernel's part in a segment uses the window in that segment; a part in a segment with no window is not available on this instrument",
 "models": {
  "collagen.spyder.1500_snv_transfer_free": {
   "recorded": {
    "terms": [
     {
      "detector": "SWIR1",
      "window_nm": [
       1500,
       1550
      ],
      "gain": 0.020064
     }
    ],
    "applies_to": "the scan as measured (no correction): the model is transfer-free"
   },
   "note": "block SNV is nonlinear: Monte Carlo per scan. S1_R2 is shown on high-res scans only, so the gain is the 90th percentile of the per-scan effective gain over high-res scans as measured (median 0.0150); standard-res scans have a larger effective gain (median 0.0208, p90 0.0301) and their SDs stay below 0.5%"
  },
  "collagen.spyder.1545_lowrange": {
   "b6": false,
   "note": "a panel reader (DECISIONS 116, 119): its implied SD is computed and exported; B6 (a verdict cut within noise reach) is not applied to it, so it raises no check"
  },
  "collagen.spyder.1545_narrow": {
   "b6": false,
   "note": "a panel reader (DECISIONS 116, 119): its implied SD is computed and exported; B6 (a verdict cut within noise reach) is not applied to it, so it raises no check"
  },
  "collagen.spyder.1728_ch": {
   "b6": false,
   "note": "a panel reader (DECISIONS 116, 119): its implied SD is computed and exported; B6 (a verdict cut within noise reach) is not applied to it, so it raises no check; its SD uses the SWIR1 window 1500-1550 nm without the C-H envelope factor (bands.json), so it is a calibrated noise index, not the local SD at 1728 nm"
  }
 },
 "consensus": {
  "collagen.spyder.consensus3_median": {
   "factor": 1.0,
   "components": "the consensus file's own folded components (wc2045, wc1500, F05)",
   "basis": "Monte Carlo through the consensus (phase 0c re-derivation for wc2045, wc1500 and the OH-corrected N-H set; A19 recipe: 40 correlated-noise draws per scan, high-res through transfer v0.2): 1.0 x median of the component SDs matches the Monte Carlo median on the 40 noisy high-res scans of the pair set (median ratio 0.98; Checks 25 vs 25 by Monte Carlo, agreement 36/40); provisional"
  }
 },
 "provenance": {
  "method": "computed by the engine (format 2; DECISIONS 137): detector-local correlated noise (white noise in absorbance smoothed by a 1.25 nm Gaussian, matching the files' own residual autocorrelation) propagated exactly through each output's linear kernel on absorbance and the correction applied (each detector segment's blur matrix transposed, times its absorbance gain), linearised. Each detector's part of a kernel uses that detector's own N2 window (independent noise).",
  "checks": "Monte Carlo through the engine (transfer v0.2 + model chain): Ryder 2045 ratio 1.015; bands 1.000-1.001. Standard and v0.1 gains reproduce the Phase 0a values (Ryder 0.006102 / 0.003326; OH-corrected 2045 0.019809 / 0.009504; OH-corrected 1500 0.030097 / 0.015714). Earlier N-H set (F05) gains (0.008748 / 0.004337 standard) came from a least-squares split of Monte Carlo SDs between two collinear windows; the per-detector analytic gains here give the same total SD within ~10% on standard and noisy high-res scans and are separable. Format 2 reproduces every format-1 gain (no transfer, v0.1, v0.2) within its 6-decimal rounding (max relative 2.0e-4); Monte Carlo through the engine tracks the analytic SD within 0.3% on composed corrections and other joins (DECISIONS 137 g1).",
  "data": "noise model only; checked against within-bone scatter of a high-res variation set (statistics only)"
 },
