{
  "name": "spyder-bone-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SPYDER Bone desktop UI (Svelte 5 + TypeScript + Vite). api.ts is the only IPC boundary.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
