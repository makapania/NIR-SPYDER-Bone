{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SPYDER Bone",
  "version": "0.1.4",
  "identifier": "org.spyderbone.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SPYDER Bone",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Scores ASD LabSpec 4 NIR scans of bone, scan by scan.",
    "longDescription": "SPYDER Bone reads ASD LabSpec 4 NIR scans of bone (standard and high-resolution) and says, scan by scan, whether that spot is worth destructive sampling for radiocarbon, ZooMS or stable isotopes.",
    "copyright": "MIT (code); CC-BY-4.0 (model files)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "../../plugins/": "plugins/"
    }
  }
}
